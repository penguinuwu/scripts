#!/bin/bash

case $button in
	1|2|3) pamixer --toggle-mute;;
	4) pamixer --allow-boost --set-limit 200 --increase 2;;
	5) pamixer --allow-boost --set-limit 200 --decrease 2;;
esac

mute=$(pamixer --get-mute)
# nf-cod-mute
[ "$mute" == "true" ] && echo " " && exit 0

# nf-cod-unmute
echo " $(pamixer --get-volume)%"
exit 0
